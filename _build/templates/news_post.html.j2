{% extends "base.html.j2" %}
{% block content %}
<p class="lede">{{ page.summary }}</p>
{%- for s in page.sections %}
<h2 id="{{ s.id }}">{{ s.h }}</h2>
{{ s.body }}
{%- endfor %}
{%- if page.faq %}
<h2 id="faq" class="withmascot">{% if mascot('faq') %}<img class="mascot small" src="{{ rel }}{{ mascot('faq') }}" alt="" width="64" height="64" loading="lazy" decoding="async">{% endif %}Frequently asked</h2>
{%- for f in page.faq %}
<h3>{{ f.q }}</h3>
<p>{{ f.a }}</p>
{%- endfor %}
{%- endif %}
{%- if page.sources %}
<h2 id="sources">Sources</h2>
<ul>
{%- for src in page.sources %}
<li><a href="{{ src.href }}" rel="nofollow noopener" target="_blank">{{ src.label }}</a></li>
{%- endfor %}
</ul>
{%- endif %}
{% endblock %}
