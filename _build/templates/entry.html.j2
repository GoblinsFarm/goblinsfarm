{% extends "base.html.j2" %}

{#- The stat rail: what a reader came to look up, pinned beside the article
    instead of buried in it. On a narrow window the grid drops it back above the
    prose, which is why the infobox has to be self-contained markup rather than
    something positioned. #}
{% block aside %}
{%- if page.quick or page.sections|length > 2 %}
<aside class="statrail">
{%- if page.quick %}
<div class="infobox tone-{{ page.tone }}{% if page.quick_wordy %} wordy{% endif %}">
  <div class="ib-title">{{ page.h1 }}</div>
  {%- if page.image %}
  <div class="ib-art{% if not page.image.photo %} drawn{% endif %}">
    <img src="{{ rel }}{{ page.image.src }}" alt="{{ page.h1 }}{% if page.image.photo %} — Clash of Clans{% endif %}" width="200" height="200" decoding="async">
  </div>
  {%- endif %}
  {%- if page.tags %}
  <div class="ib-tags">{% for t in page.tags %}<span class="tag {{ t.kind|default('') }}">{{ t.label }}</span>{% endfor %}</div>
  {%- endif %}
  <dl class="ib-rows">
  {%- for k, v in page.quick.items() %}
    <div class="ib-row"><dt>{{ k }}</dt><dd{% if v == site.todo %} class="todo"{% endif %}>{{ v|cost }}</dd></div>
  {%- endfor %}
  </dl>
  {%- if page.nav_label and page.crumbs and page.crumbs|length > 2 and page.crumbs[2].href %}<div class="ib-foot"><a href="{{ rel }}{{ page.crumbs[2].href }}">All {{ page.nav_label|lower }}</a></div>{% endif %}
</div>
{%- endif %}
{%- if page.sections|length > 2 %}
<nav class="toc" aria-label="On this page">
<h2>On this page</h2>
<ol>
{%- for s in page.sections %}
<li><a href="#{{ s.id }}">{{ s.h }}</a></li>
{%- endfor %}
{%- if page.mentions %}<li><a href="#mentions">What this page talks about</a></li>{% endif %}
{%- if page.gear %}<li><a href="#gear">Equipment for this hero</a></li>{% endif %}
{%- if page.unlocks %}<li><a href="#unlocks">What it unlocks</a></li>{% endif %}
{%- if page.strip %}<li><a href="#levels">How it looks at each level</a></li>{% endif %}
{%- if page.tables %}<li><a href="#stats">Stats by level</a></li>{% endif %}
{%- if page.faq %}<li><a href="#faq">Frequently asked</a></li>{% endif %}
</ol>
</nav>
{%- endif %}
</aside>
{%- endif %}
{% endblock %}

{% block content %}
<p class="lede">{{ page.summary }}</p>
{%- if page.stat_only %}
<div class="note speaks">{% if mascot('stat_only') %}<span class="medallion"><img class="mascot" src="{{ rel }}{{ mascot('stat_only') }}" alt="" width="90" height="90" loading="lazy" decoding="async"></span>{% endif %}<div><p><b>Reference page.</b> This entry carries verified level data but does not yet have a written strategy section. Behaviour and counter notes are being added across the wiki; the tables below are as complete as the source snapshot allows.</p></div></div>
{%- endif %}

{%- for s in page.sections %}
<h2 id="{{ s.id }}">{{ s.h }}</h2>
{{ s.body }}
{%- endfor %}

{%- if page.mentions %}
<div class="block">
<h2 id="mentions" class="withmascot">{% if mascot('mentions') %}<span class="medallion"><img class="mascot small" src="{{ rel }}{{ mascot('mentions') }}" alt="" width="64" height="64" loading="lazy" decoding="async"></span>{% endif %}What this page talks about</h2>
<div class="grid tiles">
{%- for m in page.mentions %}
<a class="card tile{% if m.image %} hasart{% endif %}" href="{{ rel }}{{ m.href }}">
  {%- if m.image %}<span class="plaque"><img class="thumb" src="{{ rel }}{{ m.image.src }}" alt="" width="72" height="72" loading="lazy" decoding="async"></span>{% endif %}
  <span class="cardtext"><b>{{ m.label }}</b></span>
</a>
{%- endfor %}
</div>
</div>
{%- endif %}

{%- if page.gear %}
<div class="block">
<h2 id="gear" class="withmascot">{% if mascot('gear') %}<span class="medallion"><img class="mascot small" src="{{ rel }}{{ mascot('gear') }}" alt="" width="64" height="64" loading="lazy" decoding="async"></span>{% endif %}Equipment for this hero</h2>
<div class="grid tiles">
{%- for g in page.gear %}
<a class="card tile{% if g.image %} hasart{% endif %} tone-ore" href="{{ rel }}{{ g.href }}">
  {%- if g.image %}<span class="plaque"><img class="thumb" src="{{ rel }}{{ g.image.src }}" alt="" width="72" height="72" loading="lazy" decoding="async"></span>{% endif %}
  <span class="cardtext"><b>{{ g.label }}</b></span>
</a>
{%- endfor %}
</div>
</div>
{%- endif %}

{%- if page.unlocks %}
<div class="block">
<h2 id="unlocks" class="withmascot">{% if mascot('unlocks') %}<span class="medallion"><img class="mascot small" src="{{ rel }}{{ mascot('unlocks') }}" alt="" width="64" height="64" loading="lazy" decoding="async"></span>{% endif %}What it unlocks</h2>
<div class="grid tiles">
{%- for u in page.unlocks %}
<a class="card tile{% if u.image %} hasart{% endif %}" href="{{ rel }}{{ u.href }}">
  {%- if u.image %}<span class="plaque"><img class="thumb" src="{{ rel }}{{ u.image.src }}" alt="" width="72" height="72" loading="lazy" decoding="async"></span>{% endif %}
  <span class="cardtext"><b>{{ u.label }}</b></span>
</a>
{%- endfor %}
</div>
</div>
{%- endif %}

{%- if page.strip %}
<div class="block">
<h2 id="levels" class="withmascot">{% if mascot('levels') %}<span class="medallion"><img class="mascot small" src="{{ rel }}{{ mascot('levels') }}" alt="" width="64" height="64" loading="lazy" decoding="async"></span>{% endif %}How it looks at each level</h2>
<div class="strip">
{%- for f in page.strip %}
<figure><span class="frame"><img src="{{ rel }}{{ f.src }}" alt="{{ page.h1 }} level {{ f.level }}" loading="lazy" decoding="async"></span><figcaption>Level {{ f.level }}</figcaption></figure>
{%- endfor %}
</div>
</div>
{%- endif %}

{%- if page.tables %}
<div class="block">
<h2 id="stats">Stats by level</h2>
{%- for t in page.tables %}
<div class="tablewrap">
<table>
{%- if t.caption %}<caption>{{ t.caption }}</caption>{% endif %}
<thead><tr>{% for c in t.columns %}<th{% if loop.first and c|lower == 'level' %} class="lvl"{% endif %}>{{ c }}</th>{% endfor %}</tr></thead>
<tbody>
{%- for row in t.rows %}
<tr>{% for cell in row %}<td{% if cell == site.todo %} class="todo"{% elif loop.first and t.columns[0]|lower == 'level' %} class="lvl"{% endif %}>{% if loop.first and t.columns[0]|lower == 'level' %}<span class="lvlbadge">{{ cell }}</span>{% else %}{{ cell|cost }}{% endif %}</td>{% endfor %}</tr>
{%- endfor %}
</tbody>
</table>
</div>
{%- endfor %}
<div class="note speaks">
{%- if mascot('source') %}<span class="medallion"><img class="mascot" src="{{ rel }}{{ mascot('source') }}" alt="" width="90" height="90" loading="lazy" decoding="async"></span>{% endif %}
<div>
{%- if page.source %}
<p><b>Where these numbers come from.</b> {% if page.source.game_version %}Read from <a href="{{ page.source.url }}" rel="nofollow noopener" target="_blank">Clash of Clans' own game files</a>, client build <strong>{{ page.source.game_version }}</strong>. They are exact for that build and do not reflect anything released after it, so verify in game before committing an upgrade.{% else %}{{ page.source.caption }}. Source: <a href="{{ page.source.url }}" rel="nofollow noopener" target="_blank">{{ page.source.name }}</a>.{% endif %}</p>
{%- else %}
<p><b>Numbers pending verification.</b> Supercell rebalances troops, defences and costs in most updates, so figures here are filled from the live game rather than guessed.</p>
{%- endif %}
{%- if page.has_todo %}
<p>Cells marked <span class="todo">{{ site.todo }}</span> are values the source snapshot does not contain. They are left blank deliberately rather than estimated. A dash means the field does not apply, which is a different thing.</p>
{%- endif %}
{%- if page.source %}<p class="attrib">{{ page.source.attribution }}</p>{% endif %}
</div>
</div>
</div>
{%- endif %}

{%- if page.faq %}
<h2 id="faq" class="withmascot">{% if mascot('faq') %}<span class="medallion"><img class="mascot small" src="{{ rel }}{{ mascot('faq') }}" alt="" width="64" height="64" loading="lazy" decoding="async"></span>{% endif %}Frequently asked</h2>
{%- for f in page.faq %}
<h3>{{ f.q }}</h3>
<p>{{ f.a }}</p>
{%- endfor %}
{%- endif %}
{% endblock %}
