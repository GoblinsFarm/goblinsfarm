<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.head_title }}</title>
<meta name="description" content="{{ page.description }}">
<link rel="canonical" href="{{ site.base_url }}{{ page.url }}">
<meta property="og:type" content="{{ page.og_type|default('article') }}">
<meta property="og:title" content="{{ page.head_title }}">
<meta property="og:description" content="{{ page.description }}">
<meta property="og:url" content="{{ site.base_url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:image" content="{{ site.base_url }}/{{ page.image.src if page.image else 'assets/logo.png' }}">
<meta name="twitter:card" content="summary">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" type="image/png" href="/assets/favicon.png" sizes="96x96">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
{#- A reader on the patch notes should be offered the patch notes feed, not
    the news one. Every dated section declares its own; everywhere else keeps
    news as the site-wide default. #}
{%- if page.feed %}
<link rel="alternate" type="application/rss+xml" title="{{ site.name }} — {{ page.feed.title }}" href="{{ site.base_url }}/{{ page.feed.folder }}/feed.xml">
{%- else %}
<link rel="alternate" type="application/rss+xml" title="{{ site.name }} news" href="{{ site.base_url }}/news/feed.xml">
{%- endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Nunito+Sans:opsz,wght@6..12,400;6..12,700;6..12,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ rel }}assets/site.css">
{%- for block in page.jsonld %}
<script type="application/ld+json">{{ block }}</script>
{%- endfor %}
<script defer src="/assets/ph.js"></script>
<script defer src="{{ rel }}assets/search.js"></script>
</head>
<body class="tone-{{ page.tone }}">
<header class="sitebar">
  <a class="brand" href="{{ rel }}">Goblins Farm</a>
  <div class="searchbox" data-index="{{ rel }}assets/search-index.json" data-rel="{{ rel }}">
    <label class="visually-hidden" for="wikisearch">Search the wiki</label>
    <input id="wikisearch" type="search" autocomplete="off" spellcheck="false"
           placeholder="Search the wiki…" aria-expanded="false"
           aria-controls="wikisearch-results" role="combobox" aria-autocomplete="list">
    <kbd>/</kbd>
    <div class="results" id="wikisearch-results" role="listbox" hidden></div>
  </div>
  <nav class="sitenav">
    {%- for item in site.nav %}
    <a href="{{ rel }}{{ item.href }}"{% if page.section == item.section %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
  </nav>
</header>

<div class="shell{% if page.section == 'wiki' %} withrail{% endif %}">

{%- if page.section == 'wiki' %}
{#- The category rail. Every wiki page carries the whole section list, and the
    section this page belongs to is expanded to its contents, so any sibling is
    one click away. On a phone it becomes a scrolling row of section chips: the
    entry lists are too long to sit above the article there. #}
<aside class="rail" aria-label="Wiki sections">
  <a class="rail-home{% if page.url == '/wiki/' %} on{% endif %}" href="{{ rel }}wiki/">Wiki home</a>
  <nav class="rail-nav">
  {%- for s in wiki_nav %}
    <div class="rail-sec tone-{{ s.tone }}{% if page.nav_key == s.key %} on{% endif %}">
      <a class="rail-head" href="{{ rel }}{{ s.href }}"{% if page.url == '/' ~ s.href %} aria-current="page"{% endif %}>{{ s.label }}<span class="rail-n">{{ s.count }}</span></a>
      {%- if page.nav_key == s.key and s.pages %}
      <ul class="rail-items">
      {%- for it in s.pages %}
        <li><a href="{{ rel }}{{ it.href }}"{% if page.url == '/' ~ it.href %} aria-current="page"{% endif %}>{% if it.image %}<img src="{{ rel }}{{ it.image.src }}" alt="" width="22" height="22" loading="lazy" decoding="async">{% endif %}<span>{{ it.label }}</span></a></li>
      {%- endfor %}
      </ul>
      {%- endif %}
    </div>
  {%- endfor %}
  </nav>
</aside>
{%- endif %}

<main class="doc{% if not page.wide and page.section != 'wiki' %} narrow{% endif %}">
{%- if page.banner %}
{#- A section front page announces itself: the illustration carries the title
    rather than sitting above it, which is the difference between a header and a
    decoration that happens to be near one. #}
<div class="banner{% if page.hero_title %} hero{% endif %}">
  <img src="{{ rel }}{{ page.banner }}" alt="" width="1400" height="700" decoding="async">
  {%- if page.hero_title %}
  <div class="banner-text"><h1>{{ page.h1 }}</h1>{% if page.nav_label %}<p class="banner-kicker">{{ page.nav_label }}{% if page.count %} &middot; {{ page.count }} pages{% endif %}</p>{% endif %}</div>
  {%- endif %}
</div>
{%- endif %}

{%- if page.crumbs %}
<div class="crumbs">
  {%- for c in page.crumbs %}
  {%- if not loop.last %}<a href="{{ rel }}{{ c.href }}">{{ c.label }}</a><span>&rsaquo;</span>{% else %}{{ c.label }}{% endif %}
  {%- endfor %}
</div>
{%- endif %}

{%- if not page.hero_title %}
{%- if page.image %}
<div class="pagehead">
  <div class="portrait{% if not page.image.photo %} drawn{% endif %}">
    <img src="{{ rel }}{{ page.image.src }}" alt="{{ page.h1 }}{% if page.image.photo %} — Clash of Clans{% endif %}" width="128" height="128" decoding="async">
  </div>
  <div class="pagehead-text">
    <h1>{{ page.h1 }}</h1>
    {%- if page.nav_label %}<p class="kicker">{{ page.nav_label }}</p>{% endif %}
    {%- if page.tags %}
    <div class="tagrow">{% for t in page.tags %}<span class="tag {{ t.kind|default('') }}">{{ t.label }}</span>{% endfor %}</div>
    {%- endif %}
  </div>
</div>
{%- else %}
<h1>{{ page.h1 }}</h1>
{%- if page.tags %}
<div class="tagrow">{% for t in page.tags %}<span class="tag {{ t.kind|default('') }}">{{ t.label }}</span>{% endfor %}</div>
{%- endif %}
{%- endif %}
{%- endif %}
<p class="updated">Updated: {{ page.updated|default(site.updated) }}{% if page.byline %} &middot; {{ page.byline }}{% endif %}</p>

{% block content %}{% endblock %}

{%- if page.related %}
<div class="related">
<h2 class="withmascot">{% if mascot('related') %}<span class="medallion"><img class="mascot small" src="{{ rel }}{{ mascot('related') }}" alt="" width="64" height="64" loading="lazy" decoding="async"></span>{% endif %}Keep reading</h2>
<div class="readon">
{%- for r in page.related %}
<a class="readon-item{% if r.image is defined and r.image %} hasart{% endif %}" href="{{ rel }}{{ r.href }}">
  {%- if r.image is defined and r.image %}<span class="plaque sm"><img class="thumb" src="{{ rel }}{{ r.image.src }}" alt="" width="48" height="48" loading="lazy" decoding="async"></span>{% endif %}
  <span>{{ r.label }}</span>
</a>
{%- endfor %}
</div>
</div>
{%- endif %}

{%- if page.show_tool_note %}
<p class="toolnote">This page is part of the free Clash of Clans wiki we maintain at Goblins Farm. We also build <a href="{{ rel }}">a farming bot</a> for the game; the reference material here stands on its own and does not require it.</p>
{%- endif %}

<p class="legal">Goblins Farm is not affiliated with, endorsed by, sponsored by, or specifically approved by Supercell. Clash of Clans is a trademark of Supercell Oy. This material is unofficial fan content produced under Supercell's Fan Content Policy. Game values change with every update; always verify in-game before committing an upgrade.</p>
</main>

{%- block aside %}{% endblock %}
</div>

<footer class="sitefoot">
  <p><a href="{{ rel }}wiki/">Wiki</a> &middot; <a href="{{ rel }}tutorials/">Tutorials</a> &middot; <a href="{{ rel }}news/">News</a> &middot; <a href="{{ rel }}patch-notes/">Patch notes</a> &middot; <a href="{{ rel }}guides/clash-of-clans-bot.html">Bot guides</a> &middot; <a href="mailto:support@goblinsfarm.com">Contact</a></p>
</footer>
</body>
</html>
