<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.head_title }}</title>
<meta name="description" content="{{ page.description }}">
<link rel="canonical" href="{{ site.base_url }}{{ page.url }}">
<meta property="og:type" content="{{ page.og_type|default('article') }}">
<meta property="og:title" content="{{ page.head_title }}">
<meta property="og:description" content="{{ page.description }}">
<meta property="og:url" content="{{ site.base_url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:image" content="{{ site.base_url }}/{{ page.image.src if page.image else 'assets/favicon.png' }}">
<meta name="twitter:card" content="summary">
<link rel="icon" type="image/png" href="{{ rel }}assets/favicon.png">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }} news" href="{{ site.base_url }}/news/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Nunito+Sans:opsz,wght@6..12,400;6..12,700;6..12,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ rel }}assets/site.css">
{%- for block in page.jsonld %}
<script type="application/ld+json">{{ block }}</script>
{%- endfor %}
</head>
<body>
<header class="sitebar">
  <a class="brand" href="{{ rel }}">Goblins Farm</a>
  <nav>
    {%- for item in site.nav %}
    <a href="{{ rel }}{{ item.href }}"{% if page.section == item.section %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
  </nav>
</header>

<main class="doc{% if not page.wide and page.section != 'wiki' %} narrow{% endif %}">
{%- if page.crumbs %}
<div class="crumbs">
  {%- for c in page.crumbs %}
  {%- if not loop.last %}<a href="{{ rel }}{{ c.href }}">{{ c.label }}</a><span>&rsaquo;</span>{% else %}{{ c.label }}{% endif %}
  {%- endfor %}
</div>
{%- endif %}

{%- if page.image %}
<div class="pagehead">
  <div class="portrait{% if not page.image.photo %} drawn{% endif %}">
    <img src="{{ rel }}{{ page.image.src }}" alt="{{ page.h1 }}{% if page.image.photo %} — Clash of Clans{% endif %}" width="128" height="128" decoding="async">
  </div>
  <div class="pagehead-text">
    <h1>{{ page.h1 }}</h1>
    {%- if page.tags %}
    <div class="tagrow">{% for t in page.tags %}<span class="tag {{ t.kind|default('') }}">{{ t.label }}</span>{% endfor %}</div>
    {%- endif %}
  </div>
</div>
{%- else %}
<h1>{{ page.h1 }}</h1>
{%- if page.tags %}
<div class="tagrow">{% for t in page.tags %}<span class="tag {{ t.kind|default('') }}">{{ t.label }}</span>{% endfor %}</div>
{%- endif %}
{%- endif %}
<p class="updated">Updated: {{ page.updated|default(site.updated) }}{% if page.byline %} &middot; {{ page.byline }}{% endif %}</p>

{% block content %}{% endblock %}

{%- if page.related %}
<div class="related">
<h2>Keep reading</h2>
<div class="readon">
{%- for r in page.related %}
<a class="readon-item{% if r.image is defined and r.image %} hasart{% endif %}" href="{{ rel }}{{ r.href }}">
  {%- if r.image is defined and r.image %}<img class="thumb" src="{{ rel }}{{ r.image.src }}" alt="" width="48" height="48" loading="lazy" decoding="async">{% endif %}
  <span>{{ r.label }}</span>
</a>
{%- endfor %}
</div>
</div>
{%- endif %}

{%- if page.show_tool_note %}
<p class="toolnote">This page is part of the free Clash of Clans wiki we maintain at Goblins Farm. We also build <a href="{{ rel }}">a farming bot</a> for the game; the reference material here stands on its own and does not require it.</p>
{%- endif %}

<p class="legal">Goblins Farm is not affiliated with, endorsed by, sponsored by, or specifically approved by Supercell. Clash of Clans is a trademark of Supercell Oy. This material is unofficial fan content produced under Supercell's Fan Content Policy. Game values change with every update; always verify in-game before committing an upgrade.</p>
</main>

<footer class="sitefoot">
  <p><a href="{{ rel }}wiki/">Wiki</a> &middot; <a href="{{ rel }}tutorials/">Tutorials</a> &middot; <a href="{{ rel }}news/">News</a> &middot; <a href="{{ rel }}guides/clash-of-clans-bot.html">Bot guides</a> &middot; <a href="mailto:support@goblinsfarm.com">Contact</a></p>
</footer>
</body>
</html>
