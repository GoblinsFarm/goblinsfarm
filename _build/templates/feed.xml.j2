<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
<title>{{ site.name }} — Clash of Clans news</title>
<link>{{ site.base_url }}/news/</link>
<atom:link href="{{ site.base_url }}/news/feed.xml" rel="self" type="application/rss+xml"/>
<description>{{ site.news_description }}</description>
<language>en</language>
{%- for p in posts %}
<item>
<title>{{ p.title|e }}</title>
<link>{{ site.base_url }}{{ p.url }}</link>
<guid isPermaLink="true">{{ site.base_url }}{{ p.url }}</guid>
<pubDate>{{ p.rfc822 }}</pubDate>
<description>{{ p.description|e }}</description>
</item>
{%- endfor %}
</channel>
</rss>
